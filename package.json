{
  "name": "open-binder",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "SW_CACHE_VERSION=dev node scripts/generate-sw.mjs && next dev",
    "build": "node scripts/generate-sw.mjs && next build",
    "generate-sw": "node scripts/generate-sw.mjs",
    "start": "next start",
    "lint": "eslint",
