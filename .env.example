# PostgreSQL (Docker Compose)
POSTGRES_USER=binder
POSTGRES_PASSWORD=binder
POSTGRES_DB=binder

# Required for local dev outside Docker Compose (Compose builds this from POSTGRES_*)
# DATABASE_URL=postgres://binder:binder@localhost:5432/binder

# Cached card/set images (default: storage/images)
# IMAGE_STORAGE_PATH=storage/images

# Worker: enqueue initial catalog sync when DB is empty (default in Compose: true)
BOOTSTRAP_CATALOG_SYNC=true

# Worker: limit catalog sync to specific TCGdex set IDs (comma-separated)
# CATALOG_SET_IDS=base1,gym1

# Worker: max cards synced per set (debugging)
# CATALOG_SET_CARD_LIMIT=10

# Service worker cache version (npm run dev sets SW_CACHE_VERSION=dev automatically)
# SW_CACHE_VERSION=dev
